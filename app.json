{
  "expo": {
    "name": "hook",
    "slug": "hook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": [
      "hook",
      "com.googleusercontent.apps.970939309798-beud2kvciukbrbpau74oosnmlf97de2r"
    ],
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.biodun42.hook",
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Hook uses Face ID to protect your account on this device."
      }
    },
    "android": {
      "package": "com.biodun42.hook",
      "adaptiveIcon": {
        "backgroundColor": "#FFC809",
        "foregroundImage": "./assets/images/app-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#FFC809",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#000000",
      "barStyle": "light-content",
      "enforceContrast": false,
      "visible": "visible"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/web-icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Hook to use Face ID to protect your account."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#FFC809"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-market.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFC809",
          "dark": {
            "backgroundColor": "#FFC809"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "232e0943-0dff-4d12-b34d-096be84e5dbb"
      }
    },
    "owner": "biodun42"
  }
}
